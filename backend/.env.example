# Copy to .env and fill in — never commit the real .env (already gitignored at repo root)

PORT=6501

# TMDB — https://www.themoviedb.org/settings/api
TMDB_READ_ACCESS_TOKEN=
TMDB_API_KEY=

# Firebase — required once a Firebase project exists (see docs/schema.md).
# GOOGLE_APPLICATION_CREDENTIALS should point at a service-account JSON key file.
# Until both are set, Firestore-backed routes fall back to TMDB-only behaviour.
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# SMTP — sends the Email+OTP verification code (hld.md §13, api-contracts.md §11).
# Gmail: Google Account → Security → 2-Step Verification → App passwords → "Mail".
# Until both are set, /auth/email/start returns 503.
SMTP_USER=
SMTP_PASS=
