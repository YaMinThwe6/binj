# Copy to .env.local (Vite convention) — never commit real values

VITE_API_BASE_URL=http://localhost:6501

# Firebase web config — required once a Firebase project exists (see docs/schema.md)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Google Maps JS API key — frontend-safe by design (domain-restricted), see docs/hld.md §9
VITE_GOOGLE_MAPS_API_KEY=
